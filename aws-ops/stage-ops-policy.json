{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEverythingEbNeedsToShow",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticbeanstalk:Check*",
        "elasticbeanstalk:RetrieveEnvironmentInfo",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "ec2:Describe*",
        "autoscaling:Describe*",
        "elasticloadbalancing:Describe*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "s3:ListAllMyBuckets",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteOnlyStageEnvironments",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:UpdateEnvironment",
        "elasticbeanstalk:RestartAppServer",
        "elasticbeanstalk:RebuildEnvironment",
        "elasticbeanstalk:RequestEnvironmentInfo",
        "elasticbeanstalk:AbortEnvironmentUpdate"
      ],
      "Resource": "arn:aws:elasticbeanstalk:us-east-2:716429146716:environment/*/Stage*"
    },
    {
      "Sid": "AppVersionsForStageDeploys",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:CreateApplicationVersion",
        "elasticbeanstalk:CreateStorageLocation"
      ],
      "Resource": [
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:application/*",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:applicationversion/*/*",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:storage/*"
      ]
    },
    {
      "Sid": "EbBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::elasticbeanstalk-us-east-2-716429146716",
        "arn:aws:s3:::elasticbeanstalk-us-east-2-716429146716/*"
      ]
    },
    {
      "Sid": "EbStackWritesOnlyOnStageTaggedResources",
      "Effect": "Allow",
      "Action": [
        "cloudformation:UpdateStack",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback",
        "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:SetDesiredCapacity",
        "autoscaling:SuspendProcesses",
        "autoscaling:ResumeProcesses",
        "autoscaling:TerminateInstanceInAutoScalingGroup",
        "autoscaling:PutScheduledUpdateGroupAction",
        "autoscaling:DeleteScheduledAction",
        "ec2:RebootInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances",
        "elasticloadbalancing:RegisterTargets",
        "elasticloadbalancing:DeregisterTargets",
        "elasticloadbalancing:RegisterInstancesWithLoadBalancer",
        "elasticloadbalancing:DeregisterInstancesFromLoadBalancer"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/elasticbeanstalk:environment-name": "Stage*"
        }
      }
    },
    {
      "Sid": "StageAgentEnvCreateAndTerminate",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:CreateEnvironment",
        "elasticbeanstalk:TerminateEnvironment"
      ],
      "Resource": [
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:environment/Spark Ordering/Stage-agent",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:environment/Spark Ordering/spark-backend-e2e",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:application/Spark Ordering",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:applicationversion/Spark Ordering/*",
        "arn:aws:elasticbeanstalk:us-east-2:716429146716:configurationtemplate/Spark Ordering/*"
      ]
    },
    {
      "Sid": "EbEnvCreateSupport",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:RunInstances",
        "ec2:CreateTags",
        "autoscaling:CreateAutoScalingGroup",
        "autoscaling:CreateLaunchConfiguration",
        "autoscaling:CreateOrUpdateTags",
        "autoscaling:PutScalingPolicy",
        "autoscaling:PutNotificationConfiguration",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:ModifyRule",
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:SetRulePriorities",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EbAlarmsOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-2:716429146716:alarm:awseb-*"
    },
    {
      "Sid": "EbEnvTeardownOnlyOldE2eAndStageAgent",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteStack",
        "autoscaling:DeleteAutoScalingGroup",
        "autoscaling:DeleteLaunchConfiguration",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteLaunchTemplate",
        "ec2:DeleteLaunchTemplateVersions",
        "ec2:DeleteTags",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:SetDesiredCapacity",
        "autoscaling:DeletePolicy",
        "autoscaling:DeleteNotificationConfiguration",
        "autoscaling:DeleteLifecycleHook",
        "autoscaling:DeleteTags",
        "elasticloadbalancing:DeleteTargetGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/elasticbeanstalk:environment-name": ["Stage-agent", "spark-backend-e2e"]
        }
      }
    },
    {
      "Sid": "LaunchTemplateDelete",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteLaunchTemplate",
        "ec2:DeleteLaunchTemplateVersions"
      ],
      "Resource": "arn:aws:ec2:us-east-2:716429146716:launch-template/*"
    },
    {
      "Sid": "SharedLbRuleDelete",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DeleteRule",
      "Resource": "arn:aws:elasticloadbalancing:us-east-2:716429146716:listener-rule/app/SharedLB/*"
    },
    {
      "Sid": "StageAgentDeployerIamUser",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:UpdateUser",
        "iam:GetUserPolicy",
        "iam:ListUserPolicies",
        "iam:PutUserPolicy"
      ],
      "Resource": [
        "arn:aws:iam::716429146716:user/stage-agent-deployer",
        "arn:aws:iam::716429146716:user/spark-backend-e2e-deployer"
      ]
    },
    {
      "Sid": "PassOnlyTheEbRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::716429146716:role/aws-elasticbeanstalk-ec2-role",
        "arn:aws:iam::716429146716:role/aws-elasticbeanstalk-service-role"
      ]
    }
  ]
}
